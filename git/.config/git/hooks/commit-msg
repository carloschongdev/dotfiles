#!/usr/bin/env bash
# Validates commit message format: type(scope): description
# Types: feat, fix, docs, chore, refactor, test, style, perf, ci, build, revert, update

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits
if echo "$COMMIT_MSG" | grep -qE "^Merge"; then
  exit 0
fi

# Skip if non-interactive (Claude Code, CI)
if [ ! -t 1 ]; then
  exit 0
fi

PATTERN="^(feat|fix|docs|chore|refactor|test|style|perf|ci|build|revert|update)(\(.+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✗ Invalid commit message format"
  echo ""
  echo "  Expected: type(scope): description"
  echo "  Example:  feat(ssh): add dual identity support"
  echo ""
  echo "  Valid types: feat, fix, docs, chore, refactor, test, style, perf, ci, build, revert, update"
  echo ""
  echo "  Your message: $COMMIT_MSG"
  echo ""
  exit 1
fi

exit 0
